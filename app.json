{
  "expo": {
    "name": "Epic Asia",
    "slug": "epicasia",
    "version": "1.0.0",
    "scheme": "epicasia",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f1ea",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benjaminjakeallen.epicasia"
    },
    "android": {
      "package": "com.benjaminjakeallen.epicasia",
      "adaptiveIcon": {
        "backgroundColor": "#f3f1ea",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Epic Asia uses your photos so you can share pictures in the group chat.",
          "cameraPermission": "Epic Asia uses the camera so you can take photos to share in the group chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Epic Asia uses your photos so you can share pictures in the group chat.",
          "savePhotosPermission": "Epic Asia saves photos from the group chat to your library when you ask it to."
        }
      ]
    ]
  }
}
